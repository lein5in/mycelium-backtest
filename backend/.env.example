MYCELIUM_ALLOWED_ORIGINS=http://localhost:5417
MYCELIUM_DEV_HOST=127.0.0.1
MYCELIUM_DEV_PORT=8417
MYCELIUM_ENABLE_YAHOO=false
MYCELIUM_ENABLE_BINANCE_ARCHIVE=false
MYCELIUM_CACHE_DIR=.cache/market
MYCELIUM_CACHE_MAX_MB=500
MYCELIUM_CACHE_TTL_CLOSED_DAYS=30
MYCELIUM_CACHE_TTL_LIVE_SECONDS=60
MYCELIUM_REFRESH_ITEMS=coinbase:BTC-USD:1h:90,coinbase:ETH-USD:1h:90
MYCELIUM_ENVIRONMENT=development
MYCELIUM_ENABLE_FAKE_RUNS=true
MYCELIUM_ENABLE_DOCS=true
MYCELIUM_MAX_CONCURRENT_RUNS=2
MYCELIUM_QUEUE_SIZE=10
MYCELIUM_RUN_TIMEOUT_SECONDS=120
MYCELIUM_CHILD_MEMORY_MB=2048
MYCELIUM_RETENTION_MINUTES=30
MYCELIUM_MAX_RETAINED_RUNS=200
MYCELIUM_MAX_SUBSCRIBERS_PER_RUN=4
MYCELIUM_RUNS_PER_HOUR_PER_IP=12
MYCELIUM_CONCURRENT_RUNS_PER_IP=2
MYCELIUM_REQUESTS_PER_MINUTE_PER_IP=240
MYCELIUM_FORWARDED_HOPS=0
MYCELIUM_MAX_JSON_BYTES=65536
MYCELIUM_MAX_CSV_BYTES=10485760
MYCELIUM_MAX_RESULT_BARS=60000
MYCELIUM_MAX_RESULT_TRADES=5000
MYCELIUM_HEARTBEAT_SECONDS=15
